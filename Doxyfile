DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Blackline/SW"
PROJECT_BRIEF          = "C reference backend for target approach in constrained systems"
OUTPUT_DIRECTORY       = docs/doxygen

INPUT                  = README.md app/include app/src docs
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
EXCLUDE                = docs/doxygen
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_UNDOC_ENUM_VAL = NO
WARN_FORMAT            = "$file:$line: $text"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
